# Generated from scripts/settings.schema.json by configure.bat. Do not edit by hand:
# change the schema and run configure.bat (or scripts\configure.ps1 -ExampleOnly).
# Copy to .env (gitignored), or run configure.bat to create .env interactively.
# Paths are relative to the repo root. Never put secrets or absolute paths in this file.

# --- Backend
# Address the backend listens on. Keep 127.0.0.1 unless other machines must reach it.
ARCHEION_HOST=127.0.0.1
# Backend port (workspace AI / Agent APIs range, see ../CLAUDE.md).
ARCHEION_PORT=20300
# The backend's SQLite database (admin credential hash, sessions, feedback), relative to the repo root.
ARCHEION_DB_PATH=app/backend/data/archeion.db

# --- Projects
# Optional: a folder holding projects, relative to the repo root (e.g. ..), granted as the root named workspace. Registry pages without root: resolve inside it. Empty by default, so nothing is granted until you add a root (ADR 0012); prefer named roots, from the viewer's Settings page. Type - to clear it.
ARCHEION_WORKSPACE_ROOT=
# More folders projects may live in, as name=folder;name=folder (ADR 0008). A registry page picks one with root: <name>. Granting a folder lets Archeion read projects in it; leave it empty for none. Type - to clear it.
ARCHEION_ROOTS=
# Your private project registry, relative to the repo root. It must stay gitignored. setup.bat creates it from registry.example/.
ARCHEION_REGISTRY_DIR=registry

# --- Frontend
# Frontend dev server port (Vite). It proxies /api to the backend.
ARCHEION_FRONTEND_PORT=20301

# --- Sessions
# Log out after this many hours without activity.
ARCHEION_SESSION_IDLE_HOURS=12
# Log out this many days after login at the latest.
ARCHEION_SESSION_MAX_DAYS=7
