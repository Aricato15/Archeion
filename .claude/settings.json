{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "PowerShell(git config core.hooksPath:*)",
      "PowerShell(git commit --no-verify:*)",
      "PowerShell(git commit -n:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/inbox-count.ps1",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-projects": {
      "source": {
        "source": "directory",
        "path": "../_shared"
      }
    }
  },
  "enabledPlugins": {
    "workspace-core@claude-projects": true
  }
}
