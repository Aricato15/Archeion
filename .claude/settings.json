{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(gh:*)",
      "PowerShell(git push:*)",
      "PowerShell(git remote add:*)",
      "PowerShell(git remote set-url:*)",
      "PowerShell(git config core.hooksPath:*)",
      "PowerShell(gh:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-projects": {
      "source": {
        "source": "directory",
        "path": "../_shared"
      }
    }
  },
  "enabledPlugins": {
    "workspace-core@claude-projects": true
  }
}
